# Copy to .env and fill in. Never commit .env.

# Image tag to run (see GitHub releases).
APP_VERSION=latest

# Bcrypt hash of the dashboard password. Until the hash-password command exists:
#   htpasswd -bnBC 12 "" 'your-password' | tr -d ':\n'
# Keep the single quotes: they stop Docker Compose from expanding the $ signs.
APP_PASSWORD_HASH=''

# Public URL of the dashboard, used in links sent by the bot.
APP_BASE_URL=https://saude.example.com
APP_TIMEZONE=America/Sao_Paulo

# PostgreSQL credentials, used by both the app and the database container.
DB_NAME=prontuario
DB_USER=prontuario
DB_PASSWORD=

# Token from @BotFather and the only chat the bot will answer.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# Optional LLM for free text. With a cloud provider, message text leaves your server.
LLM_ENABLED=false
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=qwen3:8b
LLM_API_KEY=
